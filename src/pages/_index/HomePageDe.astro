---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import goalScreenshot from "./goal.png";
import projectScreenshot from "./project.png";
import CompanyLogos from "./CompanyLogos.astro";

const pageTitle = "Operately: Open-Source OKR- und Projektmanagement-Software";
const pageDescription =
  "Open-Source-Projektmanagement mit integriertem OKR-Zieltracking. Verwalten Sie Ziele, Projekte und Check-ins mit einer Struktur, die Ihr Team auf Kurs hält. Kostenlos starten, in wenigen Minuten selbst hosten.";

import { getLatestRelease } from "../../utils/releases";
const latestRelease = await getLatestRelease();
const signUpUrl = import.meta.env.SIGN_UP_URL || import.meta.env.PUBLIC_SIGN_UP_URL || "https://app.operately.com/sign_up";

const alternates = [
  { hreflang: "en", href: "https://operately.com/" },
  { hreflang: "de", href: "https://operately.com/de/" },
  { hreflang: "x-default", href: "https://operately.com/" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://operately.com/#organization",
    name: "Operately",
    url: "https://operately.com/",
    logo: "https://operately.com/favicon.svg",
    sameAs: [
      "https://github.com/operately/operately",
      "https://www.linkedin.com/company/92810497/",
      "https://x.com/operately",
      "https://www.youtube.com/@operately",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://operately.com/#website",
    name: "Operately",
    url: "https://operately.com/",
    description: pageDescription,
    publisher: {
      "@id": "https://operately.com/#organization",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://operately.com/#software",
    name: "Operately",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: "https://operately.com/",
    description: pageDescription,
    image: "https://operately.com/images/social/card-summary-large.png",
    publisher: {
      "@id": "https://operately.com/#organization",
    },
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={"/images/social/card-summary-large.png"}
  twitterCardType="summary_large_image"
  schema={schema}
  lang="de"
  alternates={alternates}
>
  <main class="bg-[#FAFAF8]">

    {/* ─── Hero ─── */}
    <section class="px-6 pt-12 sm:pt-20 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        {latestRelease && (
          <a
            href={`/releases/${latestRelease.slug}`}
            class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm text-gray-700 ring-1 ring-gray-300 hover:ring-gray-400 transition-all mb-8"
          >
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-green-500"></span>
            v{latestRelease.version} veröffentlicht
            <span class="text-operately-blue">Was ist neu &rarr;</span>
          </a>
        )}

        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl leading-[1.1]">
          Ihr Team braucht keine weitere<br class="hidden sm:block" />
          leere Fläche. Es braucht ein System.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-700">
          Operately verbindet Ziele mit Projekten durch integrierte Check-ins und
          Fortschrittsverfolgung. Open Source. Selbst hosten oder die Cloud nutzen. Kostenlos starten.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={signUpUrl}
            class="rounded-lg bg-gray-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 transition-colors"
          >
            Kostenlos starten
          </a>
          <a
            href="/install"
            class="text-sm font-semibold text-gray-700 hover:text-gray-900 transition-colors"
          >
            In 5 Minuten selbst hosten &rarr;
          </a>
        </div>
      </div>

      {/* Hero screencast */}
      <div class="mx-auto mt-16 max-w-5xl">
        <div class="rounded-2xl bg-white p-3 shadow-[0_2px_8px_rgba(0,0,0,0.04),0_8px_32px_rgba(0,0,0,0.08)] ring-1 ring-gray-100">
          <video
            autoplay
            loop
            muted
            playsinline
            class="w-full rounded-xl aspect-video"
          >
            <source
              src="https://website-assets.operately.com/operately-homepage-screencast-v1.mp4"
              type="video/mp4"
            />
          </video>
        </div>
      </div>
    </section>

    <CompanyLogos />

    {/* ─── Testimonial 1 ─── */}
    <section class="px-6 py-10 lg:px-8">
      <blockquote class="mx-auto max-w-2xl text-center">
        <p class="text-lg text-gray-700 italic leading-8">
          "Endlich haben wir einen zentralen Ort, an dem Ziele und tägliche Arbeit miteinander
          verbunden sind. Keine Statusmeetings mehr, nur um herauszufinden, wo wir stehen."
        </p>
        <footer class="mt-4 text-sm text-gray-500">
          <span class="font-medium text-gray-900">Sarah C.</span> · Head of Product
        </footer>
      </blockquote>
    </section>

    {/* ─── Goals section ─── */}
    <section class="px-6 py-16 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
              Ziele, die lebendig bleiben
            </h2>
            <p class="mt-6 text-lg leading-8 text-gray-700">
              Setzen Sie Ziele mit messbaren Vorgaben. Verbinden Sie sie mit Projekten.
              Sehen Sie den Fortschritt automatisch, sobald die Arbeit voranschreitet. Keine
              Ziele mehr, die in einer Tabelle bis zur Quartalsbesprechung vergessen werden.
            </p>
            <dl class="mt-8 space-y-4">
              <div class="flex gap-3">
                <div class="flex-shrink-0 mt-1 h-5 w-5 rounded-full bg-operately-blue flex items-center justify-center">
                  <svg class="h-3 w-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <p class="text-gray-700"><strong class="text-gray-900">Messbare Vorgaben.</strong> Keine vagen Absichten</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 mt-1 h-5 w-5 rounded-full bg-operately-blue flex items-center justify-center">
                  <svg class="h-3 w-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <p class="text-gray-700"><strong class="text-gray-900">Automatischer Fortschritt.</strong> Aus verknüpften Projekten</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 mt-1 h-5 w-5 rounded-full bg-operately-blue flex items-center justify-center">
                  <svg class="h-3 w-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <p class="text-gray-700"><strong class="text-gray-900">Regelmäßige Reviews.</strong> Integrierte Erinnerungen halten sie im Zeitplan</p>
              </div>
            </dl>
          </div>
          <div class="rounded-2xl bg-white p-3 shadow-[0_2px_8px_rgba(0,0,0,0.04),0_8px_32px_rgba(0,0,0,0.08)] ring-1 ring-gray-100">
            <Image
              src={goalScreenshot}
              alt="Zielverfolgung in Operately"
              class="w-full rounded-xl"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ─── Testimonial 2 ─── */}
    <section class="px-6 py-10 lg:px-8">
      <blockquote class="mx-auto max-w-2xl text-center">
        <p class="text-lg text-gray-700 italic leading-8">
          "Die wöchentlichen Check-ins haben unsere Kultur verändert. Die Leute wissen jetzt
          wirklich, woran andere arbeiten, ohne nachfragen zu müssen."
        </p>
        <footer class="mt-4 text-sm text-gray-500">
          <span class="font-medium text-gray-900">James R.</span> · CTO
        </footer>
      </blockquote>
    </section>

    {/* ─── Projects section ─── */}
    <section class="px-6 py-16 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
          <div class="order-2 lg:order-1 rounded-2xl bg-white p-3 shadow-[0_2px_8px_rgba(0,0,0,0.04),0_8px_32px_rgba(0,0,0,0.08)] ring-1 ring-gray-100">
            <Image
              src={projectScreenshot}
              alt="Projektmanagement in Operately"
              class="w-full rounded-xl"
            />
          </div>
          <div class="order-1 lg:order-2">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
              Projekte, die keine Betreuung brauchen
            </h2>
            <p class="mt-6 text-lg leading-8 text-gray-700">
              Jedes Projekt hat einen Verantwortlichen, Meilensteine und regelmäßige
              Check-ins. Der Fortschritt fließt automatisch nach oben. Niemand muss
              jemandem hinterherlaufen, um den Status zu erfahren.
            </p>
            <dl class="mt-8 space-y-4">
              <div class="flex gap-3">
                <div class="flex-shrink-0 mt-1 h-5 w-5 rounded-full bg-operately-blue flex items-center justify-center">
                  <svg class="h-3 w-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <p class="text-gray-700"><strong class="text-gray-900">Klare Verantwortlichkeit.</strong> Jedes Projekt hat einen Treiber</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 mt-1 h-5 w-5 rounded-full bg-operately-blue flex items-center justify-center">
                  <svg class="h-3 w-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <p class="text-gray-700"><strong class="text-gray-900">Integrierte Check-ins.</strong> Asynchrone Fortschrittsupdates nach Zeitplan</p>
              </div>
              <div class="flex gap-3">
                <div class="flex-shrink-0 mt-1 h-5 w-5 rounded-full bg-operately-blue flex items-center justify-center">
                  <svg class="h-3 w-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <p class="text-gray-700"><strong class="text-gray-900">Mit Zielen verknüpft.</strong> Projektarbeit fließt in den Zielfortschritt ein</p>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    {/* ─── Dark section: why Operately ─── */}
    <section class="bg-gray-900 px-6 py-20 lg:px-8 mt-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Struktur, die für Sie arbeitet,<br class="hidden sm:block" /> nicht umgekehrt
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-300">
          Die meisten Tools bieten unendliche Flexibilität und null Orientierung. Operately
          gibt Ihrem Team ein klares System: Ziele mit Vorgaben, Projekte mit Verantwortlichen
          und Check-ins, die nach Zeitplan stattfinden. Sie erhalten Abstimmung ohne Mikromanagement.
        </p>
        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          <div>
            <p class="text-3xl font-bold text-white">Open Source</p>
            <p class="mt-2 text-sm text-gray-400">Apache-2.0-Lizenz. Volle Transparenz.</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-white">Selbst hostbar</p>
            <p class="mt-2 text-sm text-gray-400">In 5 Minuten auf Ihrer eigenen Infrastruktur bereitstellen.</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-white">Pauschalpreis</p>
            <p class="mt-2 text-sm text-gray-400">Keine Gebühren pro Sitzplatz. Fügen Sie Personen frei hinzu.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ─── Testimonial 3 ─── */}
    <section class="px-6 py-10 lg:px-8">
      <blockquote class="mx-auto max-w-2xl text-center">
        <p class="text-lg text-gray-700 italic leading-8">
          "Open Source war uns aus Compliance-Gründen wichtig, aber ehrlich gesagt sind wir
          geblieben, weil die Struktur einfach funktioniert. Unser Team mit 12 Personen läuft
          reibungsloser als damals mit 6 Personen und Notion."
        </p>
        <footer class="mt-4 text-sm text-gray-500">
          <span class="font-medium text-gray-900">Priya S.</span> · Operations Lead
        </footer>
      </blockquote>
    </section>

    {/* ─── CTA ─── */}
    <section class="px-6 py-20 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Testen Sie es mit Ihrem Team
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          Kostenlos starten. Keine Kreditkarte. In wenigen Minuten startklar.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={signUpUrl}
            class="rounded-lg bg-gray-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 transition-colors"
          >
            Kostenlos in der Cloud starten
          </a>
          <a
            href="/self-hosted"
            class="rounded-lg border border-gray-300 px-6 py-3 text-sm font-semibold text-gray-900 hover:border-gray-400 transition-colors"
          >
            Operately selbst hosten
          </a>
        </div>
        <p class="mt-6 text-sm text-gray-500">
          <a href="/" class="text-operately-blue hover:underline">Read this page in English &rarr;</a>
        </p>
      </div>
    </section>

  </main>
</BaseLayout>
