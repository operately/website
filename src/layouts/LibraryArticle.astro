---
import BaseLayout from "./BaseLayout.astro";
import "../styles/global.css";
import "../styles/anchor-links.css";
import type { CollectionEntry } from "astro:content";

interface Props { article: CollectionEntry<"library"> }
const { article } = Astro.props;
const { title, description, author, published, publishedAt, updatedAt } = article.data;
const url = new URL(`/library/${article.id}`, Astro.site).toString();
const date = updatedAt ?? publishedAt;
const schema = [
  { "@type": "Article", "@id": `${url}#article`, headline: title, description, url,
    author: { "@type": "Organization", name: author }, publisher: { "@id": "https://operately.com/#organization" },
    ...(publishedAt ? { datePublished: publishedAt.toISOString() } : {}),
    ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
  },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Library", item: new URL("/library", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: title, item: url },
  ] },
];
---
<BaseLayout title={title} description={description} image="/images/social/card-summary-large.png" twitterCardType="summary_large_image" schema={schema}>
  <Fragment slot="head">{!published && <meta name="robots" content="noindex, nofollow" />}</Fragment>
  <main class="bg-[#FAFAF8] px-6 pb-20 pt-12 sm:pt-16 lg:px-8">
    <article class="mx-auto max-w-3xl">
      <header class="mb-10">
        <a href="/library" class="text-sm font-semibold text-operately-blue hover:underline">← Library</a>
        <h1 class="mt-8 text-4xl font-bold leading-tight tracking-tight text-gray-900 sm:text-5xl">{title}</h1>
        <p class="mt-5 text-xl leading-8 text-gray-600">{description}</p>
        {date && <p class="mt-5 text-sm text-gray-500"><time datetime={date.toISOString()}>{date.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time></p>}
      </header>
      <div class="prose max-w-none lg:prose-lg prose-a:!text-operately-blue prose-headings:mt-12 prose-h2:mt-16 prose-li:marker:text-gray-400 prose-th:p-2 prose-td:text-left prose-th:text-left">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
