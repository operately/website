---
import { ArrowLeft } from "lucide-react";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TemplateGallery from "./TemplateGallery.astro";
import type { PublicTemplate } from "../../utils/templates/types";

interface Props { templates: PublicTemplate[]; selectedTemplate?: PublicTemplate }
const { templates, selectedTemplate } = Astro.props;
---
<BaseLayout title={selectedTemplate ? `${selectedTemplate.title} template` : "Templates"} description={selectedTemplate?.summary || "Browse templates for your team's projects, goals, and KPIs."}>
  <Fragment slot="head">{!templates.length && <meta name="robots" content="noindex, nofollow" />}</Fragment>
  <main class="bg-[#FAFAF8] px-6 pb-20 pt-12 sm:pt-16 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <a href="/library" class="back-link"><ArrowLeft size={16} aria-hidden="true" />Library</a>
      <header class="mb-10 mt-6">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Templates</h1>
        <p class="mt-4 text-lg leading-7 text-gray-600">A starting point for your team's projects, goals, and KPIs.</p>
      </header>
      <TemplateGallery templates={templates} selectedTemplate={selectedTemplate} />
    </div>
  </main>
</BaseLayout>

<style>
  .back-link { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: #024fac; }
  .back-link:hover { text-decoration: underline; }
  .back-link:focus-visible { outline: 2px solid #3185ff; outline-offset: 4px; border-radius: 3px; }
</style>
